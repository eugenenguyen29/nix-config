# 1Password secret references only, never values. Resolved in memory by
# `op run --env-file=op.env`; $HOST is set by the caller (see justfile).
# 1Password items per NixOS host:
#   {machine-name}-machine   username and password
#   {machine-name}-ssh-key   SSH key
TS_AUTHKEY = op://Infrastructure/$HOST-machine/ts-authkey
